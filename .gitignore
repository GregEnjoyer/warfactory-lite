mods/*
# Ship the Pack Launcher (ModDirector) bootstrap as a committed local override,
# built fresh from ../Pack-Launcher (modpack-director-universal:shadowJar).
# It cannot download itself, so it must live in the pack rather than be pulled from CurseForge.
!mods/modpack-director-universal-1.1-all.jar
# Client-only jars staged by tools/stage_client_mods.py (CI, into the serverpack zip); never commit.
client_mods/
build/
.gradle/

# Instance runtime pollution - never commit these to the pakku repo
logs/
crash-reports/
local/
.boxy/
tacz_backup/
tacz/tacz_default_gun/
tacz/.export-state.json
*.log
hs_err_pid*
usercache.json
usernamecache.json
servers.dat
rhino.local.properties
emi.json
modlist.html
manifest.json

# Local Claude Code config + machine-specific PrismLauncher instance-sync hook
.claude/settings.local.json
.claude/hooks/sync-to-instance.sh

# Local dev-workflow notes (machine-specific paths; not for the shared pack)
CLAUDE.md
